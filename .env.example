# App
SECRET_KEY=your_jwt_secret_key
PORT=4000
FRONTEND_URL=https://your-frontend-domain.com

# MongoDB — use ONE of: full URI, DATABASE_URL, or user+password+host below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/your_db_name?retryWrites=true&w=majority
# DATABASE_URL=mongodb+srv://...   # same as MONGODB_URI on many platforms
# Or build URI (no spaces; special chars in password must be URL-encoded in URI form)
# MONGODB_USER=atlas_username
# MONGODB_PASSWORD=atlas_password
# MONGODB_CLUSTER_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_DB_NAME=your_db_name

# SMS - Fast2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Razorpay (test)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay (live — uncomment for production)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_live_key_secret

# Razorpay Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# BigShip
BIGSHIP_BASE_URL=https://api.bigship.in/
BIGSHIP_API_KEY=your_bigship_api_key
BIGSHIP_USER=your_bigship_email
BIGSHIP_PASSWORD=your_bigship_password
BIGSHIP_ACCESS_KEY=your_bigship_access_key

# Shiprocket
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password

# ---------------------------------------------------------------------------
# Password auth
# ---------------------------------------------------------------------------

# Master switch for OTP-only login. Defaults to enabled so nobody is locked out
# during rollout. Set to "false" once password adoption plateaus — that is what
# converts this feature into SMS savings. Signup and password reset are
# deliberately unaffected: phone ownership still has to be proven somewhere.
AUTH_OTP_LOGIN_ENABLED=true

# Rate-limit ceilings. Defaults shown; raise only with a reason.
# The OTP limits protect the Fast2SMS balance (Rs.0.11-0.21 per message).
AUTH_LOGIN_RATE_LIMIT=10          # per IP per 15 min
AUTH_OTP_RATE_LIMIT=3             # per phone per 15 min
AUTH_OTP_HOURLY_RATE_LIMIT=10     # per phone per hour

# Test database for `npm test`. MUST be a separate database — the suite wipes
# every collection between cases and refuses to run unless the database name
# contains "test".
MONGODB_URI_TEST=mongodb+srv://<user>:<pass>@<cluster>/attri_test?retryWrites=true&w=majority
